{
  "name": "hora-do-corte",
  "version": "0.1.0",
  "private": true,
  "description": "App de agendamento online para pequenas barbearias.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "contrast": "node scripts/contrast.mjs",
    "emulators": "firebase emulators:start --project demo-hora-do-corte",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "definir-dono": "node --env-file=.env.local scripts/definir-dono.mjs",
    "test": "vitest run tests/unit",
    "test:integracao": "firebase emulators:exec --project demo-hora-do-corte --only auth,firestore \"vitest run tests/integration\"",
    "test:e2e": "playwright test",
    "deploy:regras": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^1.74.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.36.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
