rules_version = '2';

// Hora do corte — todo acesso aos dados passa pelo servidor (Next.js + Firebase Admin SDK),
// que verifica a sessão e o perfil antes de ler ou gravar.
// O navegador NUNCA acessa o Firestore diretamente: tudo é negado aqui.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
