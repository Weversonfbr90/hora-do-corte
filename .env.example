# Hora do corte — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA faça commit do .env.local.

# ---------------------------------------------------------------
# Desenvolvimento local com emuladores do Firebase (padrão)
# Com USE_FIREBASE_EMULATORS=true, não é preciso conta Google.
# ---------------------------------------------------------------
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------------------------------------------------------------
# Firebase — app web (públicas: vão para o navegador)
# Console do Firebase → Configurações do projeto → Seus apps → Web
# ---------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-hora-do-corte
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------
# Firebase Admin — SECRETAS (só no servidor)
# Console do Firebase → Configurações → Contas de serviço → Gerar nova chave privada
# Em produção (Vercel), cadastre como variáveis de ambiente do projeto.
# ---------------------------------------------------------------
FIREBASE_PROJECT_ID=demo-hora-do-corte
FIREBASE_CLIENT_EMAIL=
# Cole a chave entre aspas, com os \n literais: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=
